{
  "name": "b1",
  "source": "b1.c",
  "cpp_args": "-I/ariadne/plugin/share -I/ariadne/bench/sglib_spec",
  "frama_c": ["-load-module", "/ariadne/plugin/_build/default/ariadne.cmxs",
              "-cpp-extra-args=-I/ariadne/plugin/share -I/ariadne/bench/sglib_spec",
              "-generated-spec-custom", "terminates:skip", "-ariadne"],
  "rte": ["-rte", "-rte-initialized", "@all"],
  "wp": ["-wp-model", "Typed", "-wp-no-filter-init",
         "-wp-prover", "alt-ergo,z3,cvc5,coq", "-wp-timeout", "60"],
  "passes": [
    {"name": "functions", "goals": 310,
     "options": ["-wp-rte", "-rte-initialized", "@all", "-wp-fct",
                 "sglib_dllist_add,sglib_dllist_it_init_on_equal,sglib_dllist_it_init,sglib_dllist_it_next,sglib_dllist_get_first,sglib_dllist_get_last,b1"]},
    {"name": "lemmas", "goals": 11, "options": ["-wp-prop=@lemma"]}
  ],
  "rac": {"dir": "rac", "command": ["sh", "./check.sh"],
          "bench_line": "B1=/ariadne/bench/b1"},
  "out_of_scope": [],
  "copy_ignore": ["session/cache", "mutants", "rac/build", "*.log",
                  "report*.json", "*.vo", "*.vok", "*.vos", "*.glob",
                  ".*.aux", ".lia.cache"]
}

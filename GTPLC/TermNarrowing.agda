module TermNarrowing where

-- File Charter:
--   * Defines well-typed narrowing between GTPLC terms.
--   * Relates terms under type, type-store, and term-context narrowing.
--   * Tracks each relation by a bundled well-typed narrowing.
--   * Uses a mutually defined quotient phase for paired narrowing casts.
--   * Closes the quotient phase with paired widening casts.

open import Data.List using (_∷_)
open import Data.Nat using (zero; suc)
open import Data.Product using (_,_)

open import Types hiding (_∋_⦂_)
open import TyStore
open import Ctx
open import Coercions hiding (_↦_; gen)
open import Coercions using () renaming (gen to genᶜ)
open import Terms
open import Primitives
open import NarrowWiden hiding (_↦_; ∀ⁿ_; gen)
open import EnvironmentNarrowing
open import ImprecisionTheorems using
  ( ∀ⁿ_
  ; gen
  ; _↦_
  ; dualʷ
  ; ⇑ⁿ
  ; ⇑ᴿⁿ
  ; _⨟ⁿ_
  ; _⨟ˡⁿ_
  ; _≐ⁿ_
  )
open import proof.TypeInTypeSubst using
  ( TyRenameWf-suc
  ; renameᵗ-preserves-WfTy
  )

------------------------------------------------------------------------
-- Environment narrowing under type-context extension
------------------------------------------------------------------------

⇑ˢⁿ : ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ}
  → Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ
  → ((zero ˣ⊑ˣ zero) ∷ ⇑ᵢ Φ)
      ∣ suc Δᴸ ⊢ ⟰ᵗ Σᴸ ⊒ˢ ⟰ᵗ Σᴿ ⊣ suc Δᴿ
⇑ˢⁿ []ˢ = []ˢ
⇑ˢⁿ (bothˢ p σ) = bothˢ (⇑ⁿ p) (⇑ˢⁿ σ)
⇑ˢⁿ (leftˢ σ) = leftˢ (⇑ˢⁿ σ)
⇑ˢⁿ (rightˢ hB σ) =
  rightˢ (renameᵗ-preserves-WfTy hB TyRenameWf-suc) (⇑ˢⁿ σ)

⇑ᴿˢⁿ : ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ}
  → Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ
  → ((zero ˣ⊑★) ∷ ⇑ᴸᵢ Φ)
      ∣ Δᴸ ⊢ Σᴸ ⊒ˢ ⟰ᵗ Σᴿ ⊣ suc Δᴿ
⇑ᴿˢⁿ []ˢ = []ˢ
⇑ᴿˢⁿ (bothˢ p σ) = bothˢ (⇑ᴿⁿ p) (⇑ᴿˢⁿ σ)
⇑ᴿˢⁿ (leftˢ σ) = leftˢ (⇑ᴿˢⁿ σ)
⇑ᴿˢⁿ (rightˢ hB σ) =
  rightˢ (renameᵗ-preserves-WfTy hB TyRenameWf-suc) (⇑ᴿˢⁿ σ)

⇑ᵍⁿ : ∀ {Φ Δᴸ Δᴿ Γᴸ Γᴿ}
  → Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ
  → ((zero ˣ⊑ˣ zero) ∷ ⇑ᵢ Φ)
      ∣ suc Δᴸ ⊢ ⤊ᵗ Γᴸ ⊒ᵍ ⤊ᵗ Γᴿ ⊣ suc Δᴿ
⇑ᵍⁿ []ᵍ = []ᵍ
⇑ᵍⁿ (bothᵍ p γ) = bothᵍ (⇑ⁿ p) (⇑ᵍⁿ γ)

⇑ᴿᵍⁿ : ∀ {Φ Δᴸ Δᴿ Γᴸ Γᴿ}
  → Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ
  → ((zero ˣ⊑★) ∷ ⇑ᴸᵢ Φ)
      ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ ⤊ᵗ Γᴿ ⊣ suc Δᴿ
⇑ᴿᵍⁿ []ᵍ = []ᵍ
⇑ᴿᵍⁿ (bothᵍ p γ) = bothᵍ (⇑ᴿⁿ p) (⇑ᴿᵍⁿ γ)

------------------------------------------------------------------------
-- Term narrowing, with a quotient phase for paired casts
------------------------------------------------------------------------

infix 4 _∣_∣_∣_∣_⊢ᴺ_⊒_⦂_⊒_∶_
infix 4 _∣_∣_∣_∣_⊢ᴺᵖ_⊒_⦂_⊒ᵖ_∶_

mutual

  data _∣_∣_∣_∣_⊢ᴺ_⊒_⦂_⊒_∶_ :
      (Φ : ImpCtx) (Δᴸ Δᴿ : TyCtx) →
      {Σᴸ Σᴿ : TyStore} {Γᴸ Γᴿ : Ctx} →
      Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ →
      Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ →
      Term → Term → (A B : Ty) →
      Φ ∣ Δᴸ ⊢ A ⊒ B ⊣ Δᴿ → Set₁ where

    ⊒blame : ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ M A B}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {p : Φ ∣ Δᴸ ⊢ A ⊒ B ⊣ Δᴿ}
      → Δᴸ ∣ Σᴸ ∣ Γᴸ ⊢ M ⦂ A
        ------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ M ⊒ blame ⦂ A ⊒ B ∶ p

    x⊒x : ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ x A B}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {p : Φ ∣ Δᴸ ⊢ A ⊒ B ⊣ Δᴿ}
      → γ ∋ x ⦂ p
        ------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ ` x ⊒ ` x ⦂ A ⊒ B ∶ p

    ƛ⊒ƛ :
        ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ N N′ A A′ B B′}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {c : Φ ∣ Δᴿ ⊢ A′ ⊑ A ⊣ Δᴸ}
          {d : Φ ∣ Δᴸ ⊢ B ⊒ B′ ⊣ Δᴿ}
      → WfTy Δᴸ A
      → WfTy Δᴿ A′
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ bothᵍ (dualʷ c) γ ⊢ᴺ N ⊒ N′ ⦂ B ⊒ B′ ∶ d
        -------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ ƛ N ⊒ ƛ N′ ⦂ A ⇒ B ⊒ A′ ⇒ B′ ∶ (c ↦ d)

    ·⊒· :
        ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ L L′ M M′}
          {A A′ B B′}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {c : Φ ∣ Δᴿ ⊢ A′ ⊑ A ⊣ Δᴸ}
          {d : Φ ∣ Δᴸ ⊢ B ⊒ B′ ⊣ Δᴿ}
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ L ⊒ L′ ⦂ A ⇒ B ⊒ A′ ⇒ B′ ∶ (c ↦ d)
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ M ⊒ M′ ⦂ A ⊒ A′ ∶ dualʷ c
        ------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ L · M ⊒ L′ · M′ ⦂ B ⊒ B′ ∶ d

    up⊒up :
        ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ N N′ A A′ D D′}
          {u u′}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {q : Φ ∣ Δᴸ ⊢ D ⊒ D′ ⊣ Δᴿ}
          {u⊑ : idᵢ Δᴸ ∣ Δᴸ ⊢ u ⦂ D ⊑ A ⊣ Δᴸ}
          {u′⊑ : idᵢ Δᴿ ∣ Δᴿ ⊢ u′ ⦂ D′ ⊑ A′ ⊣ Δᴿ}
          {p : Φ ∣ Δᴸ ⊢ A ⊒ A′ ⊣ Δᴿ}
          {μ μ′}
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺᵖ N ⊒ N′ ⦂ D ⊒ᵖ D′ ∶ q
      → μ ∣ Δᴸ ∣ Σᴸ ⊢ u ∶ D =⇒ A
      → μ′ ∣ Δᴿ ∣ Σᴿ ⊢ u′ ∶ D′ =⇒ A′
      → dualʷ (u , u⊑) ⨟ˡⁿ q ≐ⁿ p ⨟ⁿ dualʷ (u′ , u′⊑)
        ------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ N ⟨ u ⟩ ⊒ N′ ⟨ u′ ⟩ ⦂ A ⊒ A′ ∶ p

    Λ⊒Λ :
        ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ V V′ A B}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {p : ((zero ˣ⊑ˣ zero) ∷ ⇑ᵢ Φ) ∣ suc Δᴸ ⊢ A ⊒ B ⊣ suc Δᴿ}
      → Value V
      → Value V′
      → ((zero ˣ⊑ˣ zero) ∷ ⇑ᵢ Φ) ∣ suc Δᴸ ∣ suc Δᴿ ∣ ⇑ˢⁿ σ ∣ ⇑ᵍⁿ γ
          ⊢ᴺ V ⊒ V′ ⦂ A ⊒ B ∶ p
        ------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ Λ V ⊒ Λ V′ ⦂ `∀ A ⊒ `∀ B ∶ ∀ⁿ p

    ⊒Λ :
        ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ N V′ A B}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {p : ((zero ˣ⊑★) ∷ ⇑ᴸᵢ Φ) ∣ Δᴸ ⊢ B ⊒ A ⊣ suc Δᴿ}
          {nvA z∈A B≢★}
      → Value V′
      → ((zero ˣ⊑★) ∷ ⇑ᴸᵢ Φ) ∣ Δᴸ ∣ suc Δᴿ ∣ ⇑ᴿˢⁿ σ ∣ ⇑ᴿᵍⁿ γ
          ⊢ᴺ N ⊒ V′ ⦂ B ⊒ A ∶ p
        --------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ N ⊒ Λ V′ ⦂ B ⊒ `∀ A ∶ gen nvA z∈A p B≢★

    ⊒⟨ν⟩ :
        ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ N V′ A B C c μ}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {p : ((zero ˣ⊑★) ∷ ⇑ᴸᵢ Φ) ∣ Δᴸ ⊢ B ⊒ A ⊣ suc Δᴿ}
          {nvA z∈A B≢★}
      → Value V′
      → Δᴿ ∣ Σᴿ ∣ Γᴿ ⊢ V′ ⦂ C
      → WfTy Δᴿ C
      → genᵈ μ ∣ suc Δᴿ ∣ ⟰ᵗ Σᴿ ⊢ c ∶ ⇑ᵗ C =⇒ A
      → ((zero ˣ⊑★) ∷ ⇑ᴸᵢ Φ) ∣ Δᴸ ∣ suc Δᴿ ∣ ⇑ᴿˢⁿ σ ∣ ⇑ᴿᵍⁿ γ
          ⊢ᴺ N ⊒ (⇑ᵗᵐ V′) ⟨ c ⟩ ⦂ B ⊒ A ∶ p
        -----------------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ N ⊒ V′ ⟨ genᶜ c ⟩ ⦂ B ⊒ `∀ A ∶ gen nvA z∈A p B≢★

    ν⊒ν :
        ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ L L′ A A′ B B′ C C′}
          {c c′ μ μ′}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {p : Φ ∣ Δᴸ ⊢ B ⊒ B′ ⊣ Δᴿ}
          {q : ((zero ˣ⊑ˣ zero) ∷ ⇑ᵢ Φ) ∣ suc Δᴸ ⊢ C ⊒ C′ ⊣ suc Δᴿ}
      → (a : Φ ∣ Δᴸ ⊢ A ⊒ A′ ⊣ Δᴿ)
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ L ⊒ L′ ⦂ `∀ C ⊒ `∀ C′
          ∶ ∀ⁿ q
      → μ ∣ suc Δᴸ ∣ ((zero , ⇑ᵗ A) ∷ ⟰ᵗ Σᴸ) ⊢ c ∶ C =⇒ ⇑ᵗ B
      → μ′ ∣ suc Δᴿ ∣ ((zero , ⇑ᵗ A′) ∷ ⟰ᵗ Σᴿ) ⊢ c′ ∶ C′ =⇒ ⇑ᵗ B′
      → (c⊒ : idᵢ (suc Δᴸ) ∣ suc Δᴸ ⊢ c ⦂ C ⊒ ⇑ᵗ B ⊣ suc Δᴸ)
      → (c′⊒ : idᵢ (suc Δᴿ) ∣ suc Δᴿ ⊢ c′ ⦂ C′ ⊒ ⇑ᵗ B′ ⊣ suc Δᴿ)
      → (c , c⊒) ⨟ˡⁿ ⇑ⁿ p ≐ⁿ q ⨟ⁿ (c′ , c′⊒)
        ----------------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ ν A · L •⟨ c ⟩ ⊒ ν A′ · L′ •⟨ c′ ⟩ ⦂ B ⊒ B′ ∶ p

    ⊒ν :
        ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ N L′}
          {A′ B B′ C′ c′}
          {μ′}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {p : Φ ∣ Δᴸ ⊢ B ⊒ B′ ⊣ Δᴿ}
          {q : ((zero ˣ⊑★) ∷ ⇑ᴸᵢ Φ) ∣ Δᴸ ⊢ B ⊒ C′ ⊣ suc Δᴿ}
          {nvC′ zero∈C′ B≢★}
      → WfTy Δᴿ A′
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ N ⊒ L′ ⦂ B ⊒ `∀ C′ ∶ gen nvC′ zero∈C′ q B≢★
      → μ′ ∣ suc Δᴿ ∣ ((zero , ⇑ᵗ A′) ∷ ⟰ᵗ Σᴿ) ⊢ c′ ∶ C′ =⇒ ⇑ᵗ B′
      → (c′⊒ : idᵢ (suc Δᴿ) ∣ suc Δᴿ ⊢ c′ ⦂ C′ ⊒ ⇑ᵗ B′ ⊣ suc Δᴿ)
      → q ⨟ⁿ (c′ , c′⊒) ≐ⁿ ⇑ᴿⁿ p
        ------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ N ⊒ ν A′ · L′ •⟨ c′ ⟩ ⦂ B ⊒ B′ ∶ p

    κ⊒κ : ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ n}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {p : Φ ∣ Δᴸ ⊢ ‵ `ℕ ⊒ ‵ `ℕ ⊣ Δᴿ}
        ------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ $ (κℕ n) ⊒ $ (κℕ n) ⦂ ‵ `ℕ ⊒ ‵ `ℕ ∶ p

    ⊕⊒⊕ :
        ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ L L′ M M′}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {p : Φ ∣ Δᴸ ⊢ ‵ `ℕ ⊒ ‵ `ℕ ⊣ Δᴿ}
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ L ⊒ L′ ⦂ ‵ `ℕ ⊒ ‵ `ℕ ∶ p
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ M ⊒ M′ ⦂ ‵ `ℕ ⊒ ‵ `ℕ ∶ p
        ------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ L ⊕[ addℕ ] M ⊒ L′ ⊕[ addℕ ] M′
          ⦂ ‵ `ℕ ⊒ ‵ `ℕ ∶ p

    castⁿ⊒ :
        ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ M M′ A B B′ d}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {d⊒ : idᵢ Δᴸ ∣ Δᴸ ⊢ d ⦂ A ⊒ B ⊣ Δᴸ}
          {p : Φ ∣ Δᴸ ⊢ A ⊒ B′ ⊣ Δᴿ}
          {q : Φ ∣ Δᴸ ⊢ B ⊒ B′ ⊣ Δᴿ}
          {μ}
      → μ ∣ Δᴸ ∣ Σᴸ ⊢ d ∶ A =⇒ B
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ M ⊒ M′ ⦂ A ⊒ B′ ∶ p
      → (d , d⊒) ⨟ˡⁿ q ≐ⁿ p
        ------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ M ⟨ d ⟩ ⊒ M′ ⦂ B ⊒ B′ ∶ q

    castʷ⊒ :
        ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ M M′ A B B′ u}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {u⊑ : idᵢ Δᴸ ∣ Δᴸ ⊢ u ⦂ A ⊑ B ⊣ Δᴸ}
          {p : Φ ∣ Δᴸ ⊢ A ⊒ B′ ⊣ Δᴿ}
          {q : Φ ∣ Δᴸ ⊢ B ⊒ B′ ⊣ Δᴿ}
          {μ}
      → μ ∣ Δᴸ ∣ Σᴸ ⊢ u ∶ A =⇒ B
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ M ⊒ M′ ⦂ A ⊒ B′ ∶ p
      → dualʷ (u , u⊑) ⨟ˡⁿ p ≐ⁿ q
        ------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ M ⟨ u ⟩ ⊒ M′ ⦂ B ⊒ B′ ∶ q

    ⊒castⁿ :
        ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ M M′ A A′ B′ d′}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {d′⊒ : idᵢ Δᴿ ∣ Δᴿ ⊢ d′ ⦂ A′ ⊒ B′ ⊣ Δᴿ}
          {p : Φ ∣ Δᴸ ⊢ A ⊒ A′ ⊣ Δᴿ}
          {q : Φ ∣ Δᴸ ⊢ A ⊒ B′ ⊣ Δᴿ}
          {μ′}
      → μ′ ∣ Δᴿ ∣ Σᴿ ⊢ d′ ∶ A′ =⇒ B′
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ M ⊒ M′ ⦂ A ⊒ A′ ∶ p
      → p ⨟ⁿ (d′ , d′⊒) ≐ⁿ q
        ------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ M ⊒ M′ ⟨ d′ ⟩ ⦂ A ⊒ B′ ∶ q

    ⊒castʷ :
        ∀ {Φ Δᴸ Δᴿ Σᴸ Σᴿ Γᴸ Γᴿ M M′ A A′ B′ u′}
          {σ : Φ ∣ Δᴸ ⊢ Σᴸ ⊒ˢ Σᴿ ⊣ Δᴿ}
          {γ : Φ ∣ Δᴸ ⊢ Γᴸ ⊒ᵍ Γᴿ ⊣ Δᴿ}
          {u′⊑ : idᵢ Δᴿ ∣ Δᴿ ⊢ u′ ⦂ A′ ⊑ B′ ⊣ Δᴿ}
          {p : Φ ∣ Δᴸ ⊢ A ⊒ A′ ⊣ Δᴿ}
          {q : Φ ∣ Δᴸ ⊢ A ⊒ B′ ⊣ Δᴿ}
          {μ′}
      → μ′ ∣ Δᴿ ∣ Σᴿ ⊢ u′ ∶ A′ =⇒ B′
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ M ⊒ M′ ⦂ A ⊒ A′ ∶ p
      → q ⨟ⁿ dualʷ (u′ , u′⊑) ≐ⁿ p
        ------------------------------------------------------------
      → Φ ∣ Δᴸ ∣ Δᴿ ∣ σ ∣ γ ⊢ᴺ M ⊒ M′ ⟨ u′ ⟩ ⦂ A ⊒ B′ ∶ q

  data _∣_∣_∣_∣_⊢ᴺᵖ_⊒_⦂_⊒ᵖ_∶_ :
      (Φ : ImpCtx) (Δᴸ Δᴿ : TyCtx) →
